{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qiwish-nextjs",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-14",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "qiwish-db",
      "database_id": "ec87d8d4-b80d-4ea7-b4e0-ac23904e3d3d",
      "migrations_dir": "drizzle/migrations"
    }
  ],
  // 後台上傳的圖片（商品圖、分區底圖、LINE Pay QR Code）。bucket 不開公開存取，
  // 一律經由 app/uploads/[...key]/route.ts 讀出。binding 不能取名 IMAGES：
  // @opennextjs/cloudflare 保留這個名稱給 Cloudflare Images（next/image 最佳化）使用。
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "qiwish-images"
    }
  ],
  // RESEND_API_KEY／EMAIL_FROM／ADMIN_PASSWORD／SESSION_SECRET 刻意不宣告在這裡的 "vars"：
  // Cloudflare 不允許同一個 binding 名稱同時是 var 又是 secret，且每次 `wrangler deploy`
  // 都會用這裡的 vars 覆蓋掉正式環境已用 `wrangler secret put` 設定的 secrets（曾經因此
  // 被整批清空過一次）。正式環境的值一律只用 `wrangler secret put` 管理；本地開發用
  // .dev.vars（已加進 .gitignore，不進版控）。型別透過 worker-configuration.d.ts 手動維護
  // （執行 `npx wrangler types` 前記得留意它會依這裡的 vars 重新產生，目前刻意不重新產生）。
}
